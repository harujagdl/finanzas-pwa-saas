rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function adminEmails() {
      return ["yair.tenorio.silva@gmail.com"];
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in adminEmails();
    }

    function isWorkspaceMember(workspaceId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberUids;
    }

    function isSafeWorkspaceCreate() {
      return request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.plan == "free"
        && request.resource.data.status == "active"
        && request.resource.data.maxMembers == 1;
    }

    function isSelfExpireDowngrade(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && resource.data.planExpiresAt != null
        && resource.data.planExpiresAt < request.time
        && request.resource.data.plan == "free"
        && request.resource.data.status == "expired"
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "plan",
          "status",
          "updatedAt"
        ]);
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;

      match /{subCollection=**}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /workspaces/{workspaceId} {
      allow read: if isAdmin() || isWorkspaceMember(workspaceId);
      allow create: if isSafeWorkspaceCreate();
      allow update: if isAdmin()
        || (
          isWorkspaceMember(workspaceId)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "updatedAt"
          ])
        )
        || isSelfExpireDowngrade(workspaceId);
      allow delete: if isAdmin();
    }

    match /promoCodes/{code} {
      allow read: if request.auth != null || isAdmin();
      allow create, update, delete: if isAdmin();

      match /redemptions/{uid} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    match /adminLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /admin/registrations/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read, update, delete: if isAdmin();
    }

    match /leads/{uid} {
      allow read, write: if isAdmin();
    }

    match /meta/{docId} {
      allow read, write: if isAdmin();
    }

    match /mail/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
