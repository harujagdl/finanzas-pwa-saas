rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function adminEmails() {
      return ["yair.tenorio.silva@gmail.com"];
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in adminEmails();
    }

    function isWorkspaceMember(workspaceId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberUids;
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;

      match /{subCollection=**}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /workspaces/{workspaceId} {
      allow read: if isAdmin() || isWorkspaceMember(workspaceId);
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.plan == "free";
      allow update: if isAdmin()
        || (
          isWorkspaceMember(workspaceId)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "plan",
            "status",
            "planExpiresAt",
            "maxMembers",
            "updatedAt",
            "updatedByPromoCode"
          ])
        );
      allow delete: if isAdmin();
    }

    match /promoCodes/{code} {
      allow read: if request.auth != null || isAdmin();
      allow write: if isAdmin();

      match /redemptions/{uid} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || request.auth != null;
      allow update, delete: if false;
    }

    match /admin/registrations/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read, update, delete: if isAdmin();
    }

    match /leads/{uid} {
      allow read, write: if isAdmin();
    }

    match /meta/{docId} {
      allow read, write: if isAdmin();
    }

    match /mail/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
